---
import SiteLayout from "../layouts/SiteLayout.astro";
import { workbooks } from "../workbooks/registry";
---

<SiteLayout
  title="Worksheet Workbooks"
  description="Choose a maths workbook to view and print."
>
  <main class="home">
    <header class="hero">
      <p class="eyebrow">Printable maths practice</p>
      <h1>Worksheet Workbooks</h1>
      <p class="lead">
        Pick a topic, open the workbook, then print the pages you need.
      </p>
    </header>

    <section class="catalog" aria-label="Available workbooks">
      {
        workbooks.map((workbook) => (
          <a class="card" href={workbook.href}>
            <span class="card-icon" aria-hidden="true">{workbook.icon}</span>
            <span class="card-body">
              <span class="card-title-row">
                <strong>{workbook.title}</strong>
                <span class={`status status-${workbook.status}`}>
                  {workbook.status === "ready" ? "Ready" : "Template"}
                </span>
              </span>
              <span class="card-description">{workbook.description}</span>
              <span class="card-meta">{workbook.pageCount} page{workbook.pageCount === 1 ? "" : "s"}</span>
            </span>
          </a>
        ))
      }
    </section>
  </main>
</SiteLayout>

<style>
  .home {
    max-width: 920px;
    margin: 0 auto;
    padding: 28px 20px 48px;
  }

  .hero {
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--blue-strong);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 10px;
    font-size: 34px;
    line-height: 1.1;
  }

  .lead {
    margin: 0;
    max-width: 42rem;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .catalog {
    display: grid;
    gap: 14px;
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
    padding: 18px 18px 16px;
    border: 1px solid #c7d7e1;
    border-radius: 16px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(23 50 77 / 8%);
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--blue-strong);
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .card-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: var(--blue-strong);
    font-size: 26px;
    font-weight: 900;
  }

  .card-body {
    display: grid;
    gap: 6px;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .card-title-row strong {
    font-size: 18px;
  }

  .status {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
  }

  .status-ready {
    color: #0f5132;
    background: #d1e7dd;
  }

  .status-template {
    color: #8d481f;
    background: var(--peach);
  }

  .card-description {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .card-meta {
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }
</style>
