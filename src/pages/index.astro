---
import SiteLayout from "../layouts/SiteLayout.astro";
import { workbooks } from "../workbooks/registry";

const topicCount = workbooks.length;
---

<SiteLayout
  title="Worksheet Workbooks"
  description="Choose a maths workbook to view and print."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,750&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="home">
    <div class="atmosphere" aria-hidden="true">
      <div class="atmosphere-glow"></div>
      <div class="atmosphere-grid"></div>
    </div>

    <div class="home-inner">
      <header class="hero">
        <h1 class="brand">Worksheets</h1>
        <p class="lead">
          Pick a topic, open the workbook, then print the pages you need.
        </p>
      </header>

      <section class="catalog" aria-label="Available workbooks">
        <div class="catalog-head">
          <h2 class="catalog-title">
            <span>Topics</span>
            <span class="catalog-count">{topicCount}</span>
          </h2>
        </div>

        <ul class="catalog-list">
          {
            workbooks.map((workbook) => (
              <li>
                <a class="card" href={workbook.href}>
                  <span class="card-icon" aria-hidden="true">{workbook.icon}</span>
                  <span class="card-body">
                    <span class="card-title-row">
                      <strong>{workbook.title}</strong>
                    </span>
                    <span class="card-meta">
                      {workbook.pageCount} page{workbook.pageCount === 1 ? "" : "s"}
                    </span>
                  </span>
                  <span class="card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .home {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    background: linear-gradient(180deg, #e8f4fb 0%, var(--viewer) 55%, #e4ebf0 100%);
    font-family: "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
  }

  .atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .atmosphere-glow {
    position: absolute;
    inset: -20% -10% 0;
    background:
      radial-gradient(ellipse 70% 55% at 18% 20%, rgb(43 131 184 / 22%), transparent 70%),
      radial-gradient(ellipse 55% 45% at 88% 8%, rgb(224 122 63 / 14%), transparent 65%);
  }

  .atmosphere-grid {
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      linear-gradient(rgb(43 131 184 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(43 131 184 / 7%) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, rgb(0 0 0 / 55%) 0%, transparent 78%);
  }

  .home-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(40px, 8vh, 72px) 20px 56px;
  }

  .hero {
    margin-bottom: clamp(36px, 6vh, 52px);
  }

  .brand {
    margin: 0 0 14px;
    max-width: 12ch;
    color: var(--ink);
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(42px, 8vw, 64px);
    font-weight: 750;
    font-optical-sizing: auto;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0;
    max-width: none;
    color: var(--muted);
    font-size: clamp(16px, 2.4vw, 18px);
    font-weight: 400;
    line-height: 1.55;
    white-space: nowrap;
  }

  .catalog-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 0 4px;
  }

  .catalog-title {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin: 0;
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-count {
    display: inline-grid;
    min-width: 22px;
    padding: 2px 8px;
    place-items: center;
    border-radius: 999px;
    color: var(--blue-strong);
    background: rgb(43 131 184 / 12%);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .catalog-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 18px 18px 18px 16px;
    border: 1px solid rgb(43 131 184 / 18%);
    border-radius: 18px;
    background: rgb(255 255 255 / 82%);
    color: inherit;
    text-decoration: none;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 80%) inset,
      0 10px 28px rgb(23 50 77 / 6%);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--blue-strong);
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 90%) inset,
      0 14px 32px rgb(43 131 184 / 14%);
    outline: none;
  }

  .card:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 3px;
  }

  .card-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(145deg, #3a96c9 0%, var(--blue-strong) 100%);
    font-family: Fraunces, Georgia, serif;
    font-size: 28px;
    font-weight: 650;
    line-height: 1;
    box-shadow: 0 6px 14px rgb(43 131 184 / 28%);
  }

  .card-body {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .card-title-row strong {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card-meta {
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  .card-arrow {
    color: var(--blue-strong);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    opacity: 0.55;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .card:hover .card-arrow,
  .card:focus-visible .card-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  @media (max-width: 560px) {
    .lead {
      white-space: normal;
    }

    .card {
      grid-template-columns: auto 1fr;
      gap: 14px;
    }

    .card-arrow {
      display: none;
    }

    .brand {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-arrow {
      transition: none;
    }

    .card:hover .card-arrow,
    .card:focus-visible .card-arrow {
      transform: none;
    }
  }
</style>
