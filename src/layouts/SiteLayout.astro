---
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" href={withBase("favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <meta name="theme-color" content="#2b83b8" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #17324d;
    --muted: #5e7183;
    --blue: #dff2ff;
    --blue-strong: #2b83b8;
    --blue-bright: #3a96c9;
    --blue-deep: #3279a9;
    --blue-wash: #e8f4fb;
    --peach: #fff0df;
    --peach-strong: #e07a3f;
    --paper: #ffffff;
    --rule: #a9bdca;
    --viewer: #edf2f5;
    --viewer-deep: #e4ebf0;

    /* Topic-group accents (pair: strong + bright for gradients) */
    --accent-written-methods: #2b83b8;
    --accent-written-methods-bright: #3a96c9;
    --accent-quick-practice: #e07a3f;
    --accent-quick-practice-bright: #ec9159;
    --accent-number-skills: #2f9d8a;
    --accent-number-skills-bright: #43b09d;
    --accent-algebra: #7a6bb5;
    --accent-algebra-bright: #8d7fc7;
    --accent-assessment: #c45c6a;
    --accent-assessment-bright: #d47380;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    font-family: "Trebuchet MS", "Segoe UI", Arial, sans-serif;
    color: var(--ink);
    background: var(--viewer);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  @page {
    size: A4;
    margin: 0;
  }
</style>
