---
import SiteLayout from "./SiteLayout.astro";
import ViewerToolbar from "../components/ViewerToolbar.astro";

interface Props {
  title: string;
  workbookId: string;
  expectedPages: number;
  workbookTitle: string;
}

const { title, workbookId, expectedPages, workbookTitle } = Astro.props;
---

<SiteLayout title={title}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <ViewerToolbar workbookId={workbookId} workbookTitle={workbookTitle} />
  <main
    class="pages"
    id="pages"
    data-workbook={workbookId}
    data-expected-pages={expectedPages}
  >
    <slot />
  </main>
</SiteLayout>

<style is:global>
  .pages {
    --page-gutter: 12px;
    --page-fit: min(1, (100vw - var(--page-gutter) * 2) / 210mm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(10mm * var(--page-fit));
    padding: calc(10mm * var(--page-fit)) 0;
    overflow-x: clip;
  }

  .page-frame {
    width: calc(210mm * var(--page-fit));
    height: calc(297mm * var(--page-fit));
    flex-shrink: 0;
  }

  .page {
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    padding: 10mm 10mm 8mm;
    background: var(--paper);
    box-shadow: 0 3mm 10mm rgb(23 50 77 / 18%);
    transform: scale(var(--page-fit));
    transform-origin: top left;
    break-after: page;
    page-break-after: always;
  }

  .page-frame:last-child .page {
    break-after: auto;
    page-break-after: auto;
  }

  .page-inner {
    display: grid;
    grid-template-rows: 20mm 12mm minmax(0, 1fr) 8mm;
    gap: 2mm;
    height: 100%;
  }

  .write-line {
    display: inline-block;
    width: 31mm;
    height: 4mm;
    margin-left: 2mm;
    border-bottom: 0.35mm solid var(--ink);
    vertical-align: bottom;
  }

  @media print {
    html,
    body {
      background: #fff;
    }

    .answer {
      display: none;
    }

    .pages {
      --page-fit: 1;
      display: block;
      padding: 0;
      gap: 0;
      overflow: visible;
    }

    .page-frame {
      width: auto;
      height: auto;
    }

    .page {
      margin: 0;
      box-shadow: none;
      transform: none;
    }
  }
</style>
