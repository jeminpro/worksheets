---
import SiteLayout from "./SiteLayout.astro";
import ViewerToolbar from "../components/ViewerToolbar.astro";

interface Props {
  title: string;
  workbookId: string;
  expectedPages: number;
  workbookTitle: string;
}

const { title, workbookId, expectedPages, workbookTitle } = Astro.props;
---

<SiteLayout title={title}>
  <ViewerToolbar workbookTitle={workbookTitle} />
  <main
    class="pages"
    id="pages"
    data-workbook={workbookId}
    data-expected-pages={expectedPages}
  >
    <slot />
  </main>
</SiteLayout>

<style is:global>
  .pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10mm;
    padding: 10mm 0;
  }

  .page {
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    padding: 10mm 10mm 8mm;
    background: var(--paper);
    box-shadow: 0 3mm 10mm rgb(23 50 77 / 18%);
    break-after: page;
    page-break-after: always;
  }

  .page:last-child {
    break-after: auto;
    page-break-after: auto;
  }

  .page-inner {
    display: grid;
    grid-template-rows: 20mm 12mm minmax(0, 1fr) 8mm;
    gap: 2mm;
    height: 100%;
  }

  .write-line {
    display: inline-block;
    width: 31mm;
    height: 4mm;
    margin-left: 2mm;
    border-bottom: 0.35mm solid var(--ink);
    vertical-align: bottom;
  }

  @media print {
    html,
    body {
      background: #fff;
    }

    .answer {
      display: none;
    }

    .pages {
      display: block;
      padding: 0;
    }

    .page {
      margin: 0;
      box-shadow: none;
    }
  }
</style>
