---
interface Props {
  /** Show sync status text (Local only / Synced / …). */
  showStatus?: boolean;
  /** Visual density for page headers vs viewer toolbar. */
  compact?: boolean;
}

const { showStatus = false, compact = false } = Astro.props;
---

<div
  class:list={["auth-control", { "auth-control-compact": compact }]}
  data-auth-control
  data-show-status={showStatus ? "true" : "false"}
  hidden
>
  {
    showStatus ? (
      <span class="auth-status" data-auth-status role="status" aria-live="polite" hidden></span>
    ) : null
  }
  <span class="auth-user" data-auth-user hidden></span>
  <button class="auth-button" type="button" data-auth-button>
    Sign in with Google
  </button>
</div>

<script>
  import { bindAuthControls } from "../lib/auth-control";
  bindAuthControls();
</script>

<style>
  .auth-control {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    max-width: 100%;
  }

  .auth-control[hidden] {
    display: none;
  }

  .auth-user {
    max-width: min(12rem, 40vw);
    overflow: hidden;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .auth-user[hidden] {
    display: none;
  }

  .auth-status {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .auth-status[hidden] {
    display: none;
  }

  .auth-button {
    min-width: 0;
    padding: 9px 14px;
    border: 1px solid rgb(43 131 184 / 22%);
    border-radius: 999px;
    color: var(--ink);
    background: var(--paper);
    font: 700 13px/1 "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .auth-button:hover,
  .auth-button:focus-visible {
    border-color: var(--blue-strong);
    background: var(--blue);
    outline: none;
  }

  .auth-button:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }

  .auth-control-compact .auth-button {
    padding: 8px 12px;
    background: rgb(237 242 245 / 90%);
    border-color: rgb(23 50 77 / 10%);
    color: var(--muted);
    font-weight: 600;
  }

  .auth-control-compact .auth-button:hover,
  .auth-control-compact .auth-button:focus-visible {
    color: var(--ink);
    background: #e4ebf0;
    border-color: rgb(43 131 184 / 28%);
  }

  .auth-control-compact .auth-user {
    max-width: min(9rem, 28vw);
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-button {
      transition: none;
    }
  }
</style>
