---
interface Props {
  /** Show sync status text (Local only / Synced / …). */
  showStatus?: boolean;
  /** Visual density for page headers vs viewer toolbar. */
  compact?: boolean;
}

const { showStatus = false, compact = false } = Astro.props;
---

<div
  class:list={["auth-control", { "auth-control-compact": compact }]}
  data-auth-control
  data-show-status={showStatus ? "true" : "false"}
  hidden
>
  {
    showStatus ? (
      <span class="auth-status" data-auth-status role="status" aria-live="polite" hidden></span>
    ) : null
  }

  <button class="auth-signin" type="button" data-auth-signin hidden>
    Sign in with Google
  </button>

  <div class="auth-menu" data-auth-menu hidden>
    <button
      class="auth-menu-trigger"
      type="button"
      data-auth-menu-trigger
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="Account menu"
    >
      <img
        class="auth-avatar"
        data-auth-avatar
        alt=""
        width="28"
        height="28"
        referrerpolicy="no-referrer"
        hidden
      />
      <span class="auth-avatar-fallback" data-auth-avatar-fallback aria-hidden="true" hidden
        >?</span
      >
      <span class="auth-user" data-auth-user hidden></span>
    </button>
    <div class="auth-menu-panel" data-auth-menu-panel role="menu" hidden>
      <p class="auth-menu-meta" data-auth-menu-email hidden></p>
      <button class="auth-menu-item" type="button" role="menuitem" data-auth-signout>
        Sign out
      </button>
    </div>
  </div>
</div>

<script>
  import { bindAuthControls } from "../lib/auth-control";
  bindAuthControls();
</script>

<style>
  .auth-control {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    max-width: 100%;
  }

  .auth-control[hidden] {
    display: none;
  }

  .auth-status {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .auth-status[hidden] {
    display: none;
  }

  .auth-signin,
  .auth-menu-trigger,
  .auth-menu-item {
    font: 700 13px/1 "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
    letter-spacing: 0.01em;
    cursor: pointer;
  }

  .auth-signin {
    min-width: 0;
    padding: 9px 14px;
    border: 1px solid rgb(43 131 184 / 22%);
    border-radius: 999px;
    color: var(--ink);
    background: var(--paper);
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .auth-signin:hover,
  .auth-signin:focus-visible,
  .auth-menu-trigger:hover,
  .auth-menu-trigger:focus-visible {
    border-color: var(--blue-strong);
    background: var(--blue);
    outline: none;
  }

  .auth-signin:focus-visible,
  .auth-menu-trigger:focus-visible,
  .auth-menu-item:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }

  .auth-menu {
    position: relative;
  }

  .auth-menu[hidden],
  .auth-signin[hidden] {
    display: none;
  }

  .auth-menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 2px;
    border: 1px solid rgb(43 131 184 / 22%);
    border-radius: 999px;
    color: var(--ink);
    background: var(--paper);
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .auth-avatar,
  .auth-avatar-fallback {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .auth-avatar {
    object-fit: cover;
    background: rgb(43 131 184 / 12%);
  }

  .auth-avatar[hidden],
  .auth-avatar-fallback[hidden] {
    display: none;
  }

  .auth-avatar-fallback {
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, #3a96c9 0%, var(--blue-strong) 100%);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .auth-user[hidden] {
    display: none;
  }

  .auth-menu-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 40;
    min-width: 11rem;
    padding: 6px;
    border: 1px solid rgb(43 131 184 / 18%);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: 0 12px 28px rgb(23 50 77 / 14%);
  }

  .auth-menu-panel[hidden] {
    display: none;
  }

  .auth-menu-meta {
    margin: 0;
    padding: 8px 10px 6px;
    overflow: hidden;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .auth-menu-meta[hidden] {
    display: none;
  }

  .auth-menu-item {
    display: block;
    width: 100%;
    margin: 0;
    padding: 10px 10px;
    border: 0;
    border-radius: 8px;
    color: var(--ink);
    background: transparent;
    text-align: left;
    font-weight: 600;
    transition: background 0.15s ease;
  }

  .auth-menu-item:hover,
  .auth-menu-item:focus-visible {
    background: rgb(43 131 184 / 10%);
    outline: none;
  }

  .auth-control-compact .auth-signin {
    padding: 8px 12px;
    background: rgb(237 242 245 / 90%);
    border-color: rgb(23 50 77 / 10%);
    color: var(--muted);
    font-weight: 600;
  }

  .auth-control-compact .auth-signin:hover,
  .auth-control-compact .auth-signin:focus-visible {
    color: var(--ink);
    background: #e4ebf0;
    border-color: rgb(43 131 184 / 28%);
  }

  .auth-control-compact .auth-menu-trigger {
    padding: 2px;
    background: rgb(237 242 245 / 90%);
    border-color: rgb(23 50 77 / 10%);
  }

  .auth-control-compact .auth-menu-trigger:hover,
  .auth-control-compact .auth-menu-trigger:focus-visible {
    background: #e4ebf0;
    border-color: rgb(43 131 184 / 28%);
  }

  .auth-control-compact .auth-avatar,
  .auth-control-compact .auth-avatar-fallback {
    width: 26px;
    height: 26px;
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-signin,
    .auth-menu-trigger,
    .auth-menu-item {
      transition: none;
    }
  }
</style>
