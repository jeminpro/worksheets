---
import { withBase } from "../lib/base";

interface Props {
  workbookTitle: string;
}

const { workbookTitle } = Astro.props;
---

<nav class="viewer-bar" aria-label="Worksheet viewer controls">
  <p>
    <a class="home-link" href={withBase()}>Workbooks</a>
    <span aria-hidden="true"> · </span>
    <strong>{workbookTitle}</strong>
  </p>
  <div class="viewer-actions">
    <button class="answers-button" type="button" aria-pressed="false">Answers</button>
    <button class="print-button" type="button">Print</button>
  </div>
</nav>

<script>
  const answersButton = document.querySelector(".answers-button");
  const printButton = document.querySelector(".print-button");
  const pages = document.getElementById("pages");

  answersButton?.addEventListener("click", () => {
    if (!(answersButton instanceof HTMLButtonElement) || !pages) return;
    const answersVisible = pages.classList.toggle("answers-visible");
    answersButton.setAttribute("aria-pressed", String(answersVisible));
    answersButton.textContent = answersVisible ? "Hide Answers" : "Answers";
    pages.querySelectorAll(".answer").forEach((answer) => {
      answer.setAttribute("aria-hidden", String(!answersVisible));
    });
  });

  printButton?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .viewer-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 16mm;
    padding: 3mm 6mm;
    color: #fff;
    background: var(--ink);
    box-shadow: 0 2px 10px rgb(23 50 77 / 22%);
  }

  .viewer-bar p {
    margin: 0;
    font-size: 10pt;
  }

  .home-link {
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }

  .home-link:hover,
  .home-link:focus-visible {
    text-decoration: underline;
  }

  .viewer-actions {
    display: flex;
    gap: 3mm;
  }

  .answers-button,
  .print-button {
    min-width: 28mm;
    padding: 2.2mm 4mm;
    border: 0;
    border-radius: 999px;
    color: var(--ink);
    background: #fff;
    font: 700 10pt/1 "Trebuchet MS", "Segoe UI", Arial, sans-serif;
    cursor: pointer;
  }

  .answers-button:hover,
  .answers-button:focus-visible,
  .print-button:hover,
  .print-button:focus-visible {
    background: var(--blue);
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .answers-button[aria-pressed="true"] {
    color: #fff;
    background: var(--blue-strong);
  }

  @media print {
    .viewer-bar {
      display: none;
    }
  }
</style>
