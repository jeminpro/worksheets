---
import AuthControl from "./AuthControl.astro";
import { withBase } from "../lib/base";
import { getWorkbook } from "../workbooks/registry";

interface Props {
  workbookId: string;
  workbookTitle: string;
}

const { workbookId, workbookTitle } = Astro.props;
const workbook = getWorkbook(workbookId);
const accentStyle = workbook
  ? `--accent: var(--accent-${workbook.group}); --accent-bright: var(--accent-${workbook.group}-bright);`
  : undefined;
---

<nav class="viewer-bar" aria-label="Worksheet viewer controls" style={accentStyle}>
  <div class="viewer-brand">
    <a class="home-link" href={withBase()}>
      <span class="home-chevron" aria-hidden="true">←</span>
      <span>Workbooks</span>
    </a>
    <span class="viewer-divider" aria-hidden="true"></span>
    <div class="viewer-heading">
      {workbook ? (
        <span class="viewer-icon" aria-hidden="true">{workbook.icon}</span>
      ) : null}
      <div class="viewer-heading-text">
        <p class="viewer-title">{workbookTitle}</p>
        {workbook ? (
          <p class="viewer-meta">
            {workbook.pageCount} page{workbook.pageCount === 1 ? "" : "s"}
          </p>
        ) : null}
      </div>
    </div>
  </div>

  <div class="viewer-actions">
    <button
      class="viewer-note"
      type="button"
      data-workbook-note
      data-workbook-id={workbookId}
      data-workbook-title={workbookTitle}
      data-has-note="false"
      aria-label="Add note"
      title="Add a note for this workbook"
    >
      <span class="note-label">Add note</span>
    </button>
    <button class="answers-button" type="button" aria-pressed="false">Answers</button>
    <button class="print-button" type="button">Print</button>
    <AuthControl compact />
  </div>
</nav>

<script>
  import { bindNoteButton, updateNoteButton } from "../lib/note-modal";
  import { startNotesSync, subscribeNotesChanges } from "../lib/notes-sync";
  import { getWorkbookNote } from "../lib/workbook-notes";

  const answersButton = document.querySelector(".answers-button");
  const printButton = document.querySelector(".print-button");
  const pages = document.getElementById("pages");
  const noteButton = document.querySelector(".viewer-note[data-workbook-note]");

  const workbookId =
    noteButton instanceof HTMLElement ? noteButton.dataset.workbookId : undefined;

  startNotesSync();

  if (noteButton instanceof HTMLElement && workbookId) {
    bindNoteButton(noteButton, {
      workbookId,
      workbookTitle: noteButton.dataset.workbookTitle
    });

    subscribeNotesChanges(() => {
      updateNoteButton(noteButton, getWorkbookNote(workbookId));
    });
  }

  answersButton?.addEventListener("click", () => {
    if (!(answersButton instanceof HTMLButtonElement) || !pages) return;
    const answersVisible = pages.classList.toggle("answers-visible");
    answersButton.setAttribute("aria-pressed", String(answersVisible));
    answersButton.textContent = answersVisible ? "Hide Answers" : "Answers";
    pages.querySelectorAll(".answer").forEach((answer) => {
      answer.setAttribute("aria-hidden", String(!answersVisible));
    });
  });

  printButton?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .viewer-bar {
    --accent: var(--blue-strong);
    --accent-bright: var(--blue-bright);

    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 10px clamp(14px, 3vw, 28px);
    color: var(--ink);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 92%) 0%, rgb(248 251 253 / 88%) 100%);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    box-shadow: 0 8px 24px rgb(23 50 77 / 6%);
    backdrop-filter: blur(12px);
    font-family: "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
  }

  .viewer-brand {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: center;
    min-width: 0;
  }

  .home-link {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 6px 10px 6px 8px;
    border-radius: 999px;
    color: var(--muted);
    background: transparent;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .home-chevron {
    font-size: 14px;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .home-link:hover,
  .home-link:focus-visible {
    color: var(--ink);
    background: rgb(43 131 184 / 10%);
    outline: none;
  }

  .home-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .home-link:hover .home-chevron,
  .home-link:focus-visible .home-chevron {
    transform: translateX(-2px);
  }

  .viewer-divider {
    width: 1px;
    height: 18px;
    background: rgb(43 131 184 / 22%);
  }

  .viewer-heading {
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
  }

  .viewer-icon {
    display: grid;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    color: #fff;
    background: linear-gradient(145deg, var(--accent-bright) 0%, var(--accent) 100%);
    font-family: Fraunces, Georgia, serif;
    font-size: 17px;
    font-weight: 650;
    line-height: 1;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .viewer-heading-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .viewer-title {
    margin: 0;
    min-width: 0;
    color: var(--ink);
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(16px, 2.4vw, 19px);
    font-weight: 650;
    font-optical-sizing: auto;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .viewer-meta {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
  }

  .viewer-note {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    width: max-content;
    max-width: min(16rem, 40vw);
    margin: 0;
    padding: 8px 12px;
    overflow: hidden;
    border: 1px solid rgb(23 50 77 / 10%);
    border-radius: 999px;
    color: var(--muted);
    background: rgb(237 242 245 / 90%);
    box-shadow: none;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .viewer-note :global(.note-glyph) {
    flex: 0 0 auto;
    display: block;
  }

  .viewer-note :global(.note-label) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .viewer-note[data-has-note="true"] {
    color: var(--ink);
  }

  .viewer-note[data-has-note="true"] :global(.note-glyph) {
    color: var(--blue-strong);
  }

  .viewer-note:hover,
  .viewer-note:focus-visible {
    outline: none;
    color: var(--ink);
    background: var(--viewer-deep);
    border-color: rgb(43 131 184 / 28%);
  }

  .viewer-note:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .viewer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .answers-button,
  .print-button {
    min-width: 7.5rem;
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: 999px;
    font: 700 13px/1 "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .answers-button {
    color: var(--ink);
    background: var(--paper);
    border-color: rgb(43 131 184 / 22%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 80%) inset;
  }

  .print-button {
    color: #fff;
    background: linear-gradient(145deg, var(--blue-bright) 0%, var(--blue-strong) 100%);
    box-shadow: 0 6px 14px rgb(43 131 184 / 28%);
  }

  .answers-button:hover,
  .answers-button:focus-visible {
    border-color: var(--blue-strong);
    background: var(--blue);
    outline: none;
    transform: translateY(-1px);
  }

  .print-button:hover,
  .print-button:focus-visible {
    background: linear-gradient(145deg, #48a3d4 0%, var(--blue-deep) 100%);
    outline: none;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgb(43 131 184 / 34%);
  }

  .answers-button:focus-visible,
  .print-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .answers-button[aria-pressed="true"] {
    color: #fff;
    background: var(--blue-strong);
    border-color: var(--blue-strong);
    box-shadow: 0 6px 14px rgb(43 131 184 / 24%);
  }

  .answers-button[aria-pressed="true"]:hover,
  .answers-button[aria-pressed="true"]:focus-visible {
    background: var(--blue-deep);
    border-color: var(--blue-deep);
  }

  @media (max-width: 560px) {
    .viewer-bar {
      gap: 8px;
      align-items: stretch;
      min-height: 0;
      padding: 8px 12px;
    }

    .viewer-brand {
      width: 100%;
      gap: 4px 8px;
    }

    .home-link {
      padding: 8px 10px 8px 8px;
      min-height: 40px;
    }

    .viewer-divider {
      display: none;
    }

    .viewer-title {
      font-size: 15px;
    }

    .viewer-icon {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      font-size: 14px;
    }

    .viewer-actions {
      width: 100%;
      gap: 6px;
    }

    .viewer-note {
      max-width: 100%;
      flex: 1 1 100%;
      min-height: 40px;
      padding: 8px 12px;
    }

    .answers-button,
    .print-button {
      flex: 1;
      min-width: 0;
      min-height: 40px;
      padding: 8px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-link,
    .home-chevron,
    .answers-button,
    .print-button,
    .viewer-note {
      transition: none;
    }

    .home-link:hover .home-chevron,
    .home-link:focus-visible .home-chevron,
    .answers-button:hover,
    .answers-button:focus-visible,
    .print-button:hover,
    .print-button:focus-visible {
      transform: none;
    }
  }

  @media print {
    .viewer-bar {
      display: none;
    }
  }
</style>
