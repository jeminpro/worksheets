---
import PageNumber from "../../components/PageNumber.astro";
import SheetShell from "../../components/SheetShell.astro";
import StudentDetails from "../../components/StudentDetails.astro";
import FractionsProblem from "./FractionsProblem.astro";
import type { FractionsDifficulty, FractionsSheet } from "./types";

interface Props {
  sheet: FractionsSheet;
}

const bands: readonly { key: FractionsDifficulty; title: string }[] = [
  { key: "easy", title: "Easy" },
  { key: "medium", title: "Medium" },
  { key: "hard", title: "Hard" }
];

const { sheet } = Astro.props;
const questionCount = sheet.problems.length;
---

<SheetShell label={`${sheet.label} worksheet, page ${sheet.page}`}>
  <header class="worksheet-header">
    <div class="title-icon" aria-hidden="true">11+</div>
    <div class="heading">
      <h1>{sheet.title}</h1>
      <p>{sheet.instruction}</p>
    </div>
    <PageNumber page={sheet.page} />
  </header>

  <StudentDetails questionCount={questionCount} />

  <section class="bands" aria-label={`${questionCount} fractions questions`}>
    {
      bands.map((band) => {
        const problems = sheet.problems.filter(
          (problem) => problem.difficulty === band.key
        );
        const startIndex = sheet.problems.findIndex(
          (problem) => problem.difficulty === band.key
        );

        return (
          <div class={`band ${band.key}`}>
            <h2 class="band-title">
              <span class="band-name">{band.title}</span>
              <span class="band-rule" aria-hidden="true" />
            </h2>
            <div class="band-problems">
              {problems.map((problem, index) => (
                <FractionsProblem
                  problem={problem}
                  index={startIndex + index}
                  width={index < 3 ? "narrow" : "wide"}
                />
              ))}
            </div>
          </div>
        );
      })
    }
  </section>
</SheetShell>

<style>
  .worksheet-header {
    display: flex;
    gap: 4mm;
    align-items: center;
    border-bottom: 1mm solid var(--blue-strong);
  }

  .title-icon {
    display: grid;
    width: 14mm;
    height: 14mm;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 4mm;
    color: #fff;
    background: var(--blue-strong);
    font-size: 9pt;
    font-weight: 900;
    line-height: 1;
    transform: rotate(-3deg);
  }

  .heading {
    display: grid;
    flex: 1;
    gap: 1mm;
    min-width: 0;
  }

  .heading h1,
  .heading p {
    margin: 0;
  }

  .heading h1 {
    font-size: 16pt;
    line-height: 1;
    letter-spacing: 0.1pt;
  }

  .heading p {
    color: var(--muted);
    font-size: 7.5pt;
    font-weight: 700;
    line-height: 1.2;
  }

  .bands {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 3mm;
    height: 100%;
    min-height: 0;
  }

  .band {
    --band: var(--blue-strong);

    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1.6mm;
    min-height: 0;
  }

  .band.easy {
    --band: #2f9d8a;
  }

  .band.medium {
    --band: #e07a3f;
  }

  .band.hard {
    --band: #c45c6a;
  }

  .band-title {
    display: flex;
    gap: 2mm;
    align-items: center;
    margin: 0;
  }

  .band-name {
    padding: 0.9mm 2.6mm;
    border-radius: 999px;
    color: #fff;
    background: var(--band);
    font-size: 7pt;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .band-rule {
    flex: 1;
    height: 0.3mm;
    border-radius: 999px;
    background: color-mix(in srgb, var(--band) 35%, transparent);
  }

  .band-problems {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 2.2mm;
    min-height: 0;
  }
</style>
