---
import SheetShell from "../../components/SheetShell.astro";
import StudentDetails from "../../components/StudentDetails.astro";
import PageNumber from "../../components/PageNumber.astro";
import MentalMathProblem from "./MentalMathProblem.astro";
import type { MentalMathSheet } from "./types";

interface Props {
  sheet: MentalMathSheet;
}

const { sheet } = Astro.props;
const questionCount = sheet.problems.length;
const columns = 3;
const rows = Math.ceil(questionCount / columns);
---

<SheetShell label={`${sheet.label} worksheet, page ${sheet.page}`}>
  <header class="worksheet-header">
    <div class="title-icon" aria-hidden="true">∑</div>
    <div class="heading">
      <h1>{sheet.title}</h1>
      <p>{sheet.instruction}</p>
    </div>
    <PageNumber page={sheet.page} />
  </header>

  <StudentDetails questionCount={questionCount} />

  <section
    class="problem-grid"
    style={`--rows: ${rows}`}
    aria-label={`${questionCount} mental maths questions`}
  >
    {
      sheet.problems.map((problem, index) => (
        <MentalMathProblem problem={problem} index={index} />
      ))
    }
  </section>
</SheetShell>

<style>
  .worksheet-header {
    display: flex;
    gap: 4mm;
    align-items: center;
    border-bottom: 1mm solid var(--blue-strong);
  }

  .title-icon {
    display: grid;
    width: 14mm;
    height: 14mm;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 4mm;
    color: #fff;
    background: var(--blue-strong);
    font-size: 18pt;
    font-weight: 900;
    line-height: 1;
    transform: rotate(-3deg);
  }

  .heading {
    display: grid;
    flex: 1;
    gap: 1mm;
    min-width: 0;
  }

  .heading h1,
  .heading p {
    margin: 0;
  }

  .heading h1 {
    font-size: 16pt;
    line-height: 1;
    letter-spacing: 0.1pt;
  }

  .heading p {
    color: var(--muted);
    font-size: 7.5pt;
    font-weight: 700;
    line-height: 1.2;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), minmax(0, 1fr));
    gap: 3mm;
    height: 100%;
    min-height: 0;
    align-content: stretch;
  }
</style>
