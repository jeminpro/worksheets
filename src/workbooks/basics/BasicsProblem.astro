---
import type { BasicsProblem } from "./types";
import { formatAccessiblePrompt, getDisplay } from "./expression";

interface Props {
  problem: BasicsProblem;
  index: number;
}

const { problem, index } = Astro.props;
const display = getDisplay(problem);
const accessiblePrompt = formatAccessiblePrompt(problem);
---

<article
  class:list={["problem", display]}
  aria-label={`Question ${index + 1}: ${accessiblePrompt}`}
>
  <span class="problem-number">{index + 1}</span>
  <p class="prompt">{problem.prompt}</p>
  <div class="response">
    {display === "expression" ? <span class="equals" aria-hidden="true">=</span> : null}
    <span class="answer-box">
      <span class="answer">{problem.answer}</span>
    </span>
  </div>
  <div class="working" aria-hidden="true"></div>
</article>

<style>
  .problem {
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 1.6mm;
    min-width: 0;
    min-height: 0;
    padding: 5mm 2.4mm 2mm;
    border: 0.35mm solid #c7d7e1;
    border-radius: 3mm;
    background: #fff;
  }

  .problem-number {
    position: absolute;
    top: 1.5mm;
    left: 1.6mm;
    color: var(--blue-strong);
    font-size: 6.5pt;
    font-weight: 800;
  }

  .prompt {
    margin: 0;
    min-width: 0;
    color: #152b3d;
    font-size: 9pt;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .expression .prompt {
    font-family: "Arial Rounded MT Bold", "Trebuchet MS", Arial, sans-serif;
    font-size: 14pt;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .response {
    display: flex;
    gap: 1.5mm;
    align-items: baseline;
    min-width: 0;
  }

  .expression .response {
    justify-content: center;
  }

  .equals {
    color: var(--muted);
    font-family: "Arial Rounded MT Bold", "Trebuchet MS", Arial, sans-serif;
    font-size: 14pt;
    font-weight: 800;
  }

  .answer-box {
    display: inline-flex;
    min-width: 16mm;
    min-height: 1.2em;
    flex: 1;
    justify-content: center;
    border-bottom: 0.45mm solid var(--ink);
  }

  .expression .answer-box {
    flex: 0 1 auto;
    min-width: 12mm;
  }

  .answer {
    color: var(--blue-strong);
    font-family: "Arial Rounded MT Bold", "Trebuchet MS", Arial, sans-serif;
    font-size: 14pt;
    font-weight: 800;
    line-height: 1.1;
    visibility: hidden;
  }

  :global(.answers-visible) .answer {
    visibility: visible;
  }

  .working {
    min-height: 0;
  }
</style>
